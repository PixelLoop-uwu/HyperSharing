# Copy to .env and adjust as needed. Consumed by both the app and docker-compose.

# --- App ---
DEBUG=false

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=123qwe
POSTGRES_DB=dev
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# --- MinIO (S3-compatible) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=123qwe123
S3_ENDPOINT_URL=http://localhost:9000
# Optional public endpoint for presigned URLs; empty = reuse S3_ENDPOINT_URL.
S3_PUBLIC_ENDPOINT_URL=
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=123qwe123
S3_REGION=us-east-1
S3_BUCKET=filesharing

# --- Drafts (post upload flow) ---
DRAFT_TTL_SECONDS=3600
# In-progress multipart uploads incomplete longer than this are aborted by the worker.
ABANDONED_UPLOAD_MAX_AGE_SECONDS=3600

# --- Post cache (published posts) ---
# Must stay below S3_PRESIGN_TTL_SECONDS (the cached payload contains presigned URLs).
POST_CACHE_TTL_SECONDS=300

# --- Post size limits (unique files by hash) ---
POST_MAX_FILES=20
POST_MAX_TOTAL_SIZE=104857600
POST_MAX_FILE_SIZE=52428800
POST_MAX_PARAGRAPHS=100

# --- Anonymous post limits (stricter) + creation rate limit ---
ANON_POST_MAX_FILES=5
ANON_POST_MAX_TOTAL_SIZE=20971520
ANON_POST_MAX_FILE_SIZE=10485760
ANON_POST_MAX_PARAGRAPHS=50
ANON_DRAFT_RATE_LIMIT=10
ANON_DRAFT_RATE_WINDOW_SECONDS=3600

# --- Sessions / auth ---
SESSION_COOKIE_NAME=sid
SESSION_TTL_SECONDS=604800
# Set true behind HTTPS.
SESSION_COOKIE_SECURE=false
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_SECONDS=900
PASSWORD_MIN_LENGTH=8

# --- Background jobs (arq worker) ---
JOBS_MAX_CONCURRENT=4
JOB_TIMEOUT_SECONDS=300
